# Local app and observability ports
WEB_PORT=8080
GRAFANA_PORT=3000

# Optional local Grafana login; the default stack binds only to 127.0.0.1
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Race Engineer provider. Set the Kira API key to enable generated answers.
KIRA_API_KEY=
KIRA_MODEL=gpt-oss-120b
ENGINEER_PROVIDER_URL=https://kiraai.vn/api/v1/chat/completions
ENGINEER_PROVIDER_API_KEY=
