# Local app and observability ports
WEB_PORT=8080
GRAFANA_PORT=3000

# Copy with `npm run setup:local`; setup generates a private Grafana password.
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Provider use is opt-in and its settings are passed only to the API container.
ENGINEER_PROVIDER_ENABLED=false
ENGINEER_PROVIDER_URL=
ENGINEER_PROVIDER_API_KEY=
ENGINEER_PROVIDER_MODEL=gpt-oss-120b
