# Local app and observability ports
WEB_PORT=8080
GRAFANA_PORT=3000

# Optional local Grafana login; the default stack binds only to 127.0.0.1
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Optional Race Engineer provider. Leave blank for the no-credentials profile.
ENGINEER_PROVIDER_URL=
ENGINEER_PROVIDER_API_KEY=
