local.file_match "services" {
  path_targets = [{ "__path__" = "/var/log/cognizant/*.jsonl" }]
  sync_period = "1s"
}

loki.source.file "services" {
  targets = local.file_match.services.targets
  forward_to = [loki.process.allowlisted.receiver]
}

loki.process "allowlisted" {
  forward_to = [loki.write.local.receiver]

  stage.json {
    expressions = {
      service = "service",
      environment = "environment",
      severity = "severity",
    }
  }

  stage.labels {
    values = {
      service = "",
      environment = "",
      severity = "",
    }
  }

  stage.label_keep {
    values = ["service", "environment", "severity"]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
