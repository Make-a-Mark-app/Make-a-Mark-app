{
  "name": "make-a-mark-impact-drive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:e2e:compose": "node scripts/test-compose-acceptance.mjs",
    "test:e2e:tailnet": "node scripts/test-tailnet-acceptance.mjs",
    "tailnet:up": "node scripts/tailnet-deploy.mjs up",
    "tailnet:status": "node scripts/tailnet-deploy.mjs status",
    "tailnet:down": "node scripts/tailnet-deploy.mjs down",
    "test:compose:config": "node --test scripts/test-compose-contract.mjs",
    "test:provider:config": "node --import tsx --test scripts/test-provider-config.mjs",
    "test:service:logs": "node --import tsx --test scripts/test-service-logs.mjs",
    "setup:local": "node scripts/setup-local-env.mjs",
    "start": "tsx server/index.ts",
    "build:server": "tsc -p tsconfig.server.build.json",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
